{
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://jm-movies.onrender.com/api/:path*"
    },
    {
      "source": "/sitemap:path*",
      "destination": "https://jm-movies.onrender.com/sitemap:path*"
    },
    {
      "source": "/robots.txt",
      "destination": "https://jm-movies.onrender.com/robots.txt"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
